# Copiado para .env pelo ./criar_env.sh (que também gera as duas chaves internas).
# Cole cada chave de provedor depois do "=". Provedor sem chave fica de fora.

# --- chaves internas (geradas, não compartilhe)
GW_MASTER_KEY=
GW_CHAVE_MASCARA=

# --- provedores (nomes próprios GW_* de propósito: as rotas pass-through do
# LiteLLM usam OPENAI_API_KEY/GEMINI_API_KEY etc. e passariam por fora da máscara)
GW_ROUTEWAY_KEY=
GW_NVIDIA_KEY=
GW_OPENROUTER_KEY=
GW_GROQ_KEY=
GW_CEREBRAS_KEY=

# --- opcional: modelo local já rodando (o gateway não sobe modelo)
# GW_LOCAL_URL=http://127.0.0.1:8188/v1
# GW_LOCAL_MODELO=qwen3.5-4b

# --- opcional
# GW_PORTA=4000
# GW_BLOQUEAR=SEGREDO          # tipos que barram a requisição em vez de mascarar
# GW_NER=1                     # 0 desliga a detecção de nomes de pessoa
# GW_IMAGENS=bloquear          # imagem/arquivo/áudio não é inspecionável: barrado por padrão;
#                              # 'permitir' libera (necessário para a rota visao)
# GW_HERMES_DIR=~/hermes-agent       # hermes-agent instalado (aba Chat do painel)
# GW_SECRET_GATE=~/caminho/scan.py   # scanner de segredo externo (opcional; sem ele, regras embutidas)
